<template id="index-placeholder">
  <%= render 'placeholders/index' %>
</template>

<template id="table-placeholder">
  <%= render 'placeholders/table' %>
</template>

<template id="show-placeholder">
  <%= render 'placeholders/show' %>
</template>

<template id="note-placeholder">
  <%= render 'placeholders/note' %>
</template>

<template id="form-placeholder">
  <%= render 'placeholders/form' %>
</template>

<template id="offline-modal">
  <h3 class="mb-4">You are offline</h3>
  <p>Your changes might not be saved.</p>
  <div class="mt-4">
    <button type="button" class="btn btn-danger" id="retry-btn">Retry</button>
  </div>
</template>
