<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Unpoly Demo</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name='viewport' content='width=device-width, initial-scale=1, maximum-scale=1, minimum-scale=1'>
    <%= javascript_include_tag 'application', defer: true unless up? %>
    <%= stylesheet_link_tag 'application', media: 'all' unless up? %>
    <%= favicon_link_tag("favicon.png") %>
  </head>

  <body>
    <%= render 'layouts/nav' %>

    <!-- <div class="text-secondary" id="new-version" hidden up-anchored="right">-->
    <!--   A newer version is available!-->
    <!--   <a href="javascript:location.reload()" class="btn btn-secondary btn-sm ms-2">Reload</a>-->
    <!-- </div>-->

    <div class="flashes-explainer" up-anchored="right">
      <%= tour_dot(outline: { '.flashes-explainer' => 'context' }) do %>
        <p>
          This element extracts notifications from any response,
          even when the element wasn't targeted:
        </p>

        <%= pre_code(mark: 'up-flashes') do %>
          <div up-flashes>
            Notifications go here
          </div>
        <% end %>

        <p>
          A <a href="https://unpoly.com/up.compiler">compiler</a> removes notifications
          after some seconds.
        </p>
      <% end %>

    </div>

    <div up-flashes up-anchored="right">
      <%= flashes %>
    </div>

    <main>
      <%= yield %>
    </main>

    <%= render 'layouts/fragment_explainer' %>

    <%= render 'placeholders/templates' unless up? %>

  </body>
</html>
