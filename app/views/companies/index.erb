<div class="row align-items-center gx-2 mb-4">
  <div class="col">
    <h2>All companies</h2>
  </div>

  <div class="col-sm-auto">
    <%= tour_dot(outline: { '#search-companies-form' => 'context', '#companies' => 'success' }) do %>
      <p>
        The search form submits automatically when changed.
        It only updates the list of companies below.
      </p>

      <%= pre_code(mark: ['up-target="#companies"', 'up-autosubmit']) do %>
        <form
          action="/companies"
          up-target="#companies"
          up-autosubmit
        >
          <input type="search" name="query">
        </form>
      <% end %>

      <p>
        Try checking <i>Show fragments</i> and enter a query.
      </p>

      <p>
        Forms and links are assigned an <code>up-active</code> class while loading.
        We use this class for the stripe animation on the search field.
      </p>
    <% end %>

    <%= form_tag companies_path, method: :get, class: 'd-inline-block', id: 'search-companies-form',
      'up-target': '#companies',
      'up-autosubmit': true do
    %>
      <input type="search" class="form-control" name="query" placeholder="Search…" autocomplete="off" size="17">
      <span class="search-spinner"></span>
    <% end %>
  </div>

  <div class="col-sm-auto">
    <%= tour_dot(outline:  { '#new-company-btn' => 'context', '#companies' => 'success' }) do %>
      <p>
        The <i>New company</i> button opens in an overlay:
      </p>

      <%= pre_code(mark: 'up-layer="new"') do %>
        <a
          href="<%= new_company_path %>"
          up-layer="new"
          up-accept-location="<%= company_path('$id') %>"
          up-on-accepted="up.reload('#companies')"
        >
          New company
        </a>
      <% end %>

      <p>
        When the overlay reaches the URL of a persisted company, it closes automatically.
        The project form reloads the company select so the new company appears
        as an option.
      </p>
    <% end %>

    <%= link_to 'New company', new_company_path, class: 'btn btn-primary', id: 'new-company-btn',
      'up-layer': 'new',
      'up-placeholder': '#form-placeholder',
      'up-accept-location': company_path('$id'),
      'up-on-accepted': "up.reload('#companies', { placeholder: '#table-placeholder { rows: 5 }' })"
    %>
  </div>
</div>

<div id="companies">
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
      </tr>
    </thead>

    <tbody>
      <% @companies.each_with_index do |company, i| %>
        <tr>
          <td>
            <%= link_to company.name, company,
              'up-layer': 'new',
              'up-placeholder': '#show-placeholder',
              'up-dismiss-event': 'company:destroyed',
              'up-on-dismissed': "up.reload('#companies', { placeholder: '#table-placeholder { rows: 5 }' })"
            %>

            <%= tour_dot(outline: { "a[href='#{company_path(company)}']" => 'context' }) do %>
              <p>
                This links opens a modal overlay:
              </p>
              <%= pre_code(mark: 'up-layer="new"') do %>
                <a
                  href="<%= company_path(company) %>"
                  up-layer="new"
                >
                  <%= company.name %>
                </a>
              <% end %>

              <p>
                Any existing page can be rendered into an overlay.
                The server does not need extra routes.
              </p>
            <% end if i == 0 %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
