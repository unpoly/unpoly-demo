<div class="row align-items-center mb-4">
  <div class="col">
    <h2>All projects</h2>
  </div>

  <div class="col-sm-auto">
    <%= tour_dot(outline: { '#new-project-btn' => 'context' }) do %>
      <p>
        The <i>New project</i> link opens its response in an overlay:
      </p>

      <%= pre_code(mark: 'up-layer="new"') do %>
        <a
          href="/projects/new"
          up-layer="new"
          up-accept-location="/projects/$id"
          up-on-accepted="up.reload('#projects')"
        >
          New Project
        </a>
      <% end %>

      <p>
        The button also defines a <i>close condition</i> using an <code>[up-accept-location]</code> attribute.
        This causes the overlay to automatically close when it reaches the URL of a newly created project.
      </p>
      <p>
        The <code>[up-on-accepted]</code> attribute causes the project list below to reload when the overlay closes.
      </p>
    <% end %>

    <%= link_to 'New project', new_project_path, class: 'btn btn-primary', id: 'new-project-btn',
      'up-placeholder': '#form-placeholder',
      'up-layer': 'new',
      'up-accept-location': project_path('$id'),
      'up-on-accepted': "up.reload('#projects', { placeholder: '#table-placeholder' })"
    %>
  </div>
</div>

<div id="projects">
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Company</th>
      </tr>
    </thead>

    <tbody>
      <% @projects.each_with_index do |project, i| %>
        <tr>
          <td>
            <%= link_to project.name, project,
              'up-layer': 'new',
              'up-accept-event': 'project:destroyed project:updated',
              'up-on-accepted': "up.reload('#projects', { placeholder: '#table-placeholder' })",
              'up-placeholder': '#show-placeholder'
            %>

            <%= tour_dot(outline: { "a[href='#{project_path(project)}']" => 'context' }) do %>
              <p>
                This links opens a modal overlay:
              </p>
              <%= pre_code(mark: 'up-layer="new"') do %>
                <a
                  href="<%= project_path(project) %>"
                  up-layer="new"
                >
                  <%= project.name %>
                </a>
              <% end %>

              <p>
                Any existing page can be rendered into an overlay.
                The server does not need extra routes.
              </p>
            <% end if i == 0 %>

          </td>
          <td>
            <%= project.company.name %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
