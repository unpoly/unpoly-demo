<div class="row align-items-center mb-4">
  <div class="col">
    <h2>
      Project #<%= @project.id %>

      <% if up.context[:from_company] %>
        <%= tour_dot(outline: { 'up-modal-box' => 'context' }, size: 'small') do %>
          <p>
            This overlay reuses the HTML for the
            <%= link_to 'Projects', projects_path, 'up-layer': 'root' %> section
            in the main navigation.
          </p>
        <% end %>
      <% end %>
    </h2>
  </div>

  <div class="col-sm-auto">
    <%= tour_dot(overlay_only: true, outline: { '#edit-btn': 'context' }, size: 'small') do %>
      <p>Note how the <i>Edit</i> link renders within this overlay.</p>
      <p>Links and forms always update their own layer unless another layer is targeted explicitly.</p>
    <% end %>

    <%= link_to 'Edit', [:edit, @project],
      id: 'edit-btn',
      class: 'btn btn-primary',
      'up-follow': true,
      'up-preview': 'main-spinner'
    %>

    <%= link_to 'Delete', @project, method: :delete,
      class: 'btn btn-danger mr-3',
      'up-follow': true,
      'up-preview': 'btn-spinner',
      'up-confirm': 'Really delete?'
    %>
  </div>
</div>

<dl class="my-4">
  <dt>Name</dt>
  <dd><%= @project.name %></dd>

  <dt>Company</dt>
  <dd>
    <%= link_to @project.company.name, @project.company, 'up-layer': 'swap', 'up-dismiss-location': projects_path, id: 'company-link' %>
    <%= tour_dot(outline: { '#company-link' => 'context' }) do %>
      <p>This link replaces this overlay instead of stacking on top of it:</p>

      <%= pre_code(mark: 'up-layer="swap"') do %>
        <a
          href="<%= company_path(@project.company) %>"
          up-layer="swap"
        >
          <%= @project.company.name %>
        </a>
      <% end %>

    <% end %>
  </dd>

  <dt>Budget</dt>
  <dd><%= number_to_currency(@project.budget, unit: '€') %></dd>
</dl>
