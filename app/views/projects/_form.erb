<%= form_for @project, html: {
  'up-submit': true,
  'up-disable': true,
  'up-preview': 'btn-spinner',
} do |form| %>

  <div class="form-group">
    <%= form.label :name, class: 'form-label' %>
    <div class="input-group">
      <%= form.text_field :name, class: 'form-control', autocomplete: 'off', id: 'name-field' %>
      <div class="input-group-text">
        <%= tour_dot(outline: { '#suggest-name-btn' => 'context', '#name-field' => 'success' }, size: 'large') do %>
          <p>
            The button opens a popup with suggestions for a project name:
          </p>

          <%= pre_code(mark: 'up-layer="new popup"') do %>
            <a
              href="<%= suggest_name_projects_path %>"
              up-layer="new popup"
              up-accept-event="name:select"
              up-on-accepted="
                up.fragment.get('#name-field').value = value.name
              "
            >
              Suggest name
            </a>
          <% end %>

          <p>
            When a suggestion is clicked, the choice is communicated
            back to the project form via a custom <code>name:select</code> event.</p>
          </p>
        <% end %>
      </div>

      <%= link_to suggest_name_projects_path,
        id: 'suggest-name-btn',
        class: 'btn btn-outline-secondary',
        'up-preview': 'popup-spinner',
        'up-layer': 'new popup',
        'up-align': 'right',
        'up-accept-event': 'name:select',
        'up-on-accepted': "up.fragment.get('#project_name').value = value.name" do %>
          Suggest name
      <% end %>
    </div>
    <%= form.error_message :name %>
  </div>

  <div class="form-group <%= 'd-none' if up.context[:from_company] %>" id="company-form-group">
    <%= form.label :company_id, class: 'form-label' %>

    <div class="input-group">
      <%= form.collection_select :company_id, current_tenant.companies.order(:name), :id, :name, { include_blank: '<Select a company>' }, class: 'form-select', id: 'company-field' %>
      <span class="input-group-text">
        <%= tour_dot(outline: { '#new-company-btn': 'context', '#company-field' => 'success' }, size: 'large') do %>
          <p>
            A new company can be created in an overlay while the incomplete project form
            stays open in the background:
          </p>

          <%= pre_code(mark: 'up-layer="new"') do %>
            <a
              href="<%= new_company_path %>"
              up-layer="new"
              up-accept-location="<%= company_path('$id') %>"
              up-on-accepted="
                up.validate('#company-field', {
                  params: { company_id: value.id }
                })
              "
            >
              New company
            </a>
          <% end %>

          <p>
            When the overlay reaches the URL of a persisted company, it closes automatically.
            When a company was created successfully, the overlay is automatically closed.
            The project form reloads the company select box so the new company appears
            as an option.
          </p>
        <% end %>
      </span>
      <%= link_to 'New company', new_company_path,
        class: 'btn btn-outline-secondary',
        id: 'new-company-btn',
        'up-placeholder': '#form-placeholder',
        'up-layer': 'new',
        'up-size': 'small',
        'up-accept-location': company_path('$id'),
        'up-on-accepted': "up.validate('#company-field', { params: { 'project[company_id]': value.id }, placeholder: '#form-placeholder' })"
      %>
    </div>

    <%= form.error_message :company_id %>
  </div>

  <div class="form-group">
    <div class="row">
      <div class="col-md-4">
        <%= form.label :budget, class: 'form-label' %>
        <div class="input-group">
          <%= form.text_field :budget, class: 'form-control', autocomplete: 'off' %>
          <span class="input-group-append">
            <span class="input-group-text">€</span>
          </span>
        </div>
      </div>
    </div>
    <%= form.error_message :budget %>
  </div>

  <div class="d-flex align-items-center mt-4">
    <div class="flex-grow-1">
      <%= form.button "Save", class: 'btn btn-primary', id: 'save-btn' %>

      <% if @project.new_record? %>
        <%= tour_dot(overlay_only: true, outline: { '#save-btn': 'context', 'form' => 'failure' }) do %>
          <p>Saving an invalid form will re-render validation errors in the same overlay.</p>
          <p>Links and forms always render in the same layer unless another layer is targeted explicitly.</p>
        <% end %>
      <% end %>
    </div>

    <div>
      <% if local_assigns[:cancel_path] %>
        <%= link_to 'Cancel', cancel_path,
          class: 'btn btn-outline-secondary',
          'up-follow': true,
          'up-preview': 'main-spinner'
        %>
      <% end %>
    </div>
  </div>

<% end %>
