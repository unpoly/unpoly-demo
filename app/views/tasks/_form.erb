<% task = local_assigns.fetch(:task) %>
<% target = task.new_record? ? '#tasks' : '.task' %>
<% autofocus = task.new_record? ? '#tasks' : '.task' %>
<% preview = task.new_record? ? 'add-task, btn-spinner' : 'btn-spinner' %>

<%= form_for task, html: {
  class: 'task task-form',
  id: nil,
  'autocomplete': 'off',
  'data-id': 'start',
  'up-target': target,
  'up-preview': preview,
} do |form| %>
  <% if task.new_record? %>
    <div class="task--tour-dot">
      <%= tour_dot(outline: {  target => 'success', '.task-form' => 'context' }, size: 'large') do %>
        <p>
          Adding a task <%= docs_link 'renders optimistically', '/optimistic-rendering' %>
          without waiting for the network:
        </p>

        <%= pre_code(mark: 'up-preview="add-task"') do %>
          <form
            action="<%= url_for(task) %>"
            method="post"
            up-target="#tasks"
            up-preview="add-task"
          >
            ...
          </form>
        <% end %>

        <p>
          The <i>preview</i> is a JavaScript description of a temporary change:
        </p>

        <%= pre_code(mark: ["'add-task'", "'#task-preview'"]) do %>
          up.preview('add-task', function(preview) {
            let text = preview.params.get('text')
            let item = up.template.clone('#task-preview', { text })
            let form = preview.origin.closest('form')
            preview.insert(form, 'afterend', item)
          })
        <% end %>

        <p>
          The server-rendered template is embedded into the layout:
        </p>

        <%= pre_code(mark: '"task-preview"') do %>
          <script id="task-preview" type="text/minimustache">
            <div class="task task-item -previewing">
              <span class="task-item--toggle">◯</span>
              <span class="task-item--text">{{text}}</span>
            </div>
          </script>
        <% end %>

      <% end %>
    </div>
  <% end %>
  <%= form.text_field :text, class: 'task-form--input form-control', placeholder: 'What needs to be done?', autofocus: autofocus, required: true %>
  <%= form.error_message :text, class: 'task-form--error' %>
  <%= form.button 'Save', class: 'task-form--save btn btn-primary btn-sm' %>
<% end %>
