<%= render 'tasks/head', title: 'Tasks' %>

<% content_for :tour_hint do %>
  <p>
    This screen shows many task boxes with the same selector
    (<code>&lt;div class="task"&gt;</code>).
  </p>
  <p>
    Note how changing a task will only update a single task box.
  </p>
<% end %>

<div id="tasks" class="mt-5">
  <%= render 'tasks/form', task: Task.new %>

  <% @tasks.each do |task| %>
    <%= render 'tasks/task', task: task %>
  <% end %>
</div>

<script id="task-preview" type="text/minimustache">
  <div class="task task-item -previewing">
    <span class="task-item--toggle"></span>
    <span class="task-item--text">{{text}}</span>
  </div>
</script>
